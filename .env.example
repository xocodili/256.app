# Copy to `.env` and fill in secrets. `.env` is gitignored.
#
# MySQL (sqlx) — create user/db with scripts/mysql/create_webadm_user.sql (set password there to match).
# App code forces utf8mb4 on connect (emoji-safe). Optional: ?charset=utf8mb4 on the URL for clients.
DATABASE_URL=mysql://webadm:YOUR_DB_PASSWORD@127.0.0.1:3306/twofivesix

# Server
HOST=127.0.0.1
PORT=8080
# Deployed VM: repo root (locales/, static/, agents/). systemd WorkingDirectory=~/256.app is enough;
# set explicitly if the unit runs the binary from another cwd. Optional: APP_ROOT=/home/deploy/256.app

# Global per-request hard timeout (seconds). Default 60. Sized to clear face-capture (~33s) and
# Google Places (~12s); raise only if a single handler legitimately needs longer.
# REQUEST_TIMEOUT_SECS=60

# Session cookies: set true behind HTTPS in production
SECURE_COOKIES=false

# Public URL for verification links (no trailing slash). Production: https://your-domain
PUBLIC_APP_URL=http://127.0.0.1:8080

# Reverse geocoding (OSM Nominatim). Set a clear User-Agent per https://operations.osmfoundation.org/policies/nominatim/
# NOMINATIM_USER_AGENT=256.app/1.0 (you@example.com)

# Email (SMTP) — required for verification, password reset, recruitment, engagement digest,
# Panoply daily status, and council invite review. Configured and live on beta; set SMTP_HOST in
# local `.env` for the same behavior in dev. If SMTP_HOST is unset, mail paths no-op or log at INFO.
#
# Gmail / Google Workspace (typical):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS_MODE=starttls
#   SMTP_USERNAME=youraddress@gmail.com   (or full Workspace email)
#   SMTP_PASSWORD=<16-char app password>  # Google Account → Security → App passwords
#   SMTP_FROM=256.app <youraddress@gmail.com>
#
# Generic relay (comment out Gmail block and use this shape):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=256.app <noreply@example.com>
# SMTP_TLS_MODE=starttls

# Council agent for face capture + Vertex portrait styling (`agents/council/{handle}.json`).
# Optional: COUNCIL_AGENT_HANDLE=epic
#
# Platform recruitment (human friend invites + council AI outreach) routes to this review inbox
# during rollout — intended recipient and draft personal note are named in the body.
# Optional: COUNCIL_INVITE_REVIEW_EMAIL=owner@example.com

# Platform safety contact (Safety legal card, closed-beta on-call). Default: safety@example.com
# PLATFORM_SAFETY_CONTACT_EMAIL=safety@example.com
# Optional: PLATFORM_RECRUITMENT_LIVE=1 — send human friend invites directly (council AI stays review-routed)
#
# Face capture (POST /me/face-capture): by default calls a gRPC AI gateway endpoint.
# Optional: AI_GRPC_ENDPOINT=http://127.0.0.1:50051
# Optional alias (legacy/local): GOOGLE_GRPC_ENDPOINT=http://127.0.0.1:50051
# Optional: AI_GRPC_TIMEOUT_MS=3000
# Optional: FACE_VISION_MOCK=1 — always use placeholder text instead of calling gRPC (local dev).
# Optional: SKIP_FACE_VISION_VALIDATE=1 — loopback only; skip async Vertex face gate but still run real Imagen portraiture (style-plate local testing).
# Optional: MEDIA_HASH_BLOCKLIST= — comma-separated SHA-256 hex digests; blocks matching JPEGs at avatar ingress only (face capture + redraw — Class A/B stub; point 15). No post image uploads on this product.
# Optional: VERBOSE_AI_ERRORS=0 — hide technical [debug: ...] suffixes on face-capture AI errors (default is verbose for prototyping).
#
# Local AI gateway binary (cargo run --bin ai_gateway):
# Optional: GATEWAY_HOST=127.0.0.1
# Optional: GATEWAY_PORT=50051
# Optional: GATEWAY_PROVIDER_ID=local-mock
# Optional: GATEWAY_MODEL_ID=local-gateway-mock-v1
# Optional: GATEWAY_HTTP_TIMEOUT_MS=12000
# Smooth outbound Vertex / AI Studio calls (shared by council jobs + face vision). Waits for a slot instead of bursting.
# Optional: VERTEX_GATEWAY_MAX_RPM=20
# Optional: VERTEX_GATEWAY_BURST=1
# Set VERTEX_GATEWAY_MAX_RPM=0 to disable (local mock-only).
# Optional: GOOGLE_AI_API_KEY=... (enables real Gemini multimodal text via generativelanguage.googleapis.com)
# Use a Google AI Studio / Gemini API key (starts with AIza...). Vertex-only keys may return HTTP 403 on this endpoint.
# In GCP: enable "Generative Language API" for the project; check API key restrictions allow this API.
# Optional: GOOGLE_AI_MODEL=gemini-2.5-flash-lite

# Google Maps Platform (server-side Places / Geocode for Enhanced verification). Restrict the key by API + IP in GCP.
# Optional: GOOGLE_MAPS_API_KEY=
# Optional: GOOGLE_PLACES_TIMEOUT_MS=12000
#
# Ops: POST /ops/locations/invalidate with Authorization: Bearer <token> (cadastral invalidation). If unset, route returns 404.
# Optional: OPS_LOCATION_INVALIDATE_TOKEN=
#
# Ops: POST /ops/jobs/run with Authorization: Bearer <token> (job queue conductor). If unset, route returns 404.
# Optional: OPS_JOB_QUEUE_TOKEN=
#
# Stripe — Nom pack checkout (Civic 32/A$3, Standard 64/A$5, Steward 128/A$8). Set both keys to enable.
# Optional: STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional: STRIPE_SECRET_KEY=sk_test_...
# Webhook: POST /webhooks/stripe — beta endpoint on Dashboard; local optional via `stripe listen`.
# Optional: STRIPE_WEBHOOK_SECRET=whsec_...
#
# In-process job scheduler (drives recurring system jobs + drains the queue).
# Tick interval in seconds; set to 0 to disable and run the queue only via /ops/jobs/run.
# Optional: SCHEDULER_TICK_SECS=1
# Local dev with real SMTP: set OPS_DIGEST_LIVE=0 so Panoply operator reports and away-user
# digests are not sent from your machine (beta runs the same jobs against production DB).
# OPS_DIGEST_LIVE=0
# Conductor batch size per scheduler tick (clamped to [1, 256]; default 16).
# Optional: SCHEDULER_BATCH_SIZE=16
# Max concurrent job handlers per conductor tick (beta: 4–8 when council backlog grows).
# Optional: JOB_CONDUCTOR_PARALLELISM=4
# Sub-cap for gateway/LLM-heavy job types within JOB_CONDUCTOR_PARALLELISM.
# Optional: JOB_CONDUCTOR_LLM_PARALLELISM=2
# Wall-clock budget for council_portfolio_feed_poll RSS/crawl per run (seconds).
# Optional: FEED_POLL_WALL_BUDGET_SECS=120
# systemd journal retention for daily system_journal_retention job (beta VM).
# Optional: JOURNAL_RETENTION_DAYS=3

# Face portrait pipeline (async job queue). Vision + Imagen run in ai_gateway only.
# App needs AI_GRPC_ENDPOINT (see ai_gateway section below). Portrait model id forwarded to gateway:
# Optional: PORTRAIT_RASTER_MODEL=imagen-3.0-capability-001
# Optional: PORTRAIT_RASTER_TIMEOUT_MS=90000  # per Imagen predict (3 samples); gRPC budget ≈ 2× + overhead
# Optional: FACE_CAPTURE_PENDING_DIR=tmp/face-capture-pending
# Optional: GENERATED_FACE_ART_DIR=static/generated/user-faces
#
# ai_gateway (separate process: cargo run --bin ai_gateway) — Vertex / AI Studio credentials:
# GOOGLE_APPLICATION_CREDENTIALS=./.secrets/gcp-service-account.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Optional: VERTEX_LOCATION=us-central1
# Full VM checklist: docs/BETA_AI_SETUP.md

# Optional: Google reCAPTCHA v3 (register, login, OIDC start/link)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_BYPASS=1  # local dev / CI only (requires HOST=127.0.0.1 or ::1)

# Optional: Google OIDC (social login)
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/oidc/callback

# Behind nginx/Caddy on beta/production: trust X-Forwarded-For for reCAPTCHA remoteip
# TRUSTED_PROXY=1

# Dev-only auth shortcut (never enable in production; requires loopback HOST):
# DEV_AUTH_BYPASS=1
# Then open, for example:
# /dev/auth/login-as?email=system@256.app&next=/home

# E2E Playwright seed (never enable on production DB without intent):
# E2E_SEED_ALLOW=1
# cargo run --bin e2e_seed -- --reset --manifest e2e/fixtures/manifest.json
